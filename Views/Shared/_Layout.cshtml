<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Discover the Beauty of Classical Music</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            @Html.ActionLink(@Resources.Labels.WebTitle, "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li>@Html.ActionLink(@Resources.Labels.Menu_Thaat, "Thaat", "Music", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink(@Resources.Labels.Menu_Raag, "Raagas", "Music", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink(@Resources.Labels.Menu_Tala, "Taala", "Music", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink(@Resources.Labels.Menu_Artist, "Artist", "Music", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink(@Resources.Labels.Menu_Compositions, "Compositions", "Music", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink(@Resources.Labels.Menu_Download, "Download", "Music", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink(@Resources.Labels.Menu_About, "About", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink(@Resources.Labels.Menu_Contact, "Contact", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                </ul>
                @Html.Partial("_LoginPartial")
            </div>
        </div>
        @Html.Partial("_LanguageSelector")
    </nav>
    <div class="container body-content">
        @RenderBody()
    </div>
    <div style="bottom: 0; position: fixed; font-size: smaller; text-align: center; width: 100vw; border-top: solid 1px #ccc; padding-top: 5px;">
        <footer>
            <p>&copy; @DateTime.Now.Year - ClassicalMusic.com</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
