<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Discover the Beauty of Classical Music</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            <img src="~/Images/logo-final.png" class="img-fluid" />
            @Html.ActionLink(@Resources.Labels.WebTitle, "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li>@Html.ActionLink(@Resources.Labels.Menu_Thaat, "Index", "Thaat", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink(@Resources.Labels.Menu_Raag, "Index", "Raaga", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink(@Resources.Labels.Menu_Tala, "Index", "Tala", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink(@Resources.Labels.Menu_Artist, "Artist", "Music", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink(@Resources.Labels.Menu_Compositions, "Compositions", "Music", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink(@Resources.Labels.Menu_Download, "Download", "Music", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink(@Resources.Labels.Menu_About, "About", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink(@Resources.Labels.Menu_Contact, "Contact", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                </ul>
                @Html.Partial("_LoginPartial")
            </div>
        </div>
        @*@Html.Partial("_LanguageSelector")*@
    </nav>
    <div class="container body-content">
        @RenderBody()
    </div>
    <div class="web-footer">
        <footer>
            <p>&copy; @DateTime.Now.Year - ClassicalMusic.com</p>
        </footer>
    </div>

    <!-- Validation Modal -->
    <div class="modal fade" id="validationModal" tabindex="-1" aria-labelledby="validationModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="validationModalLabel">Validation Error</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <ul id="validationErrors"></ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    @if (ViewBag.ValidationErrors != null && ((List<string>)ViewBag.ValidationErrors).Any())
    {
        <script>
        document.addEventListener("DOMContentLoaded", function () {
            var errors = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ValidationErrors));
            var ul = document.getElementById("validationErrors");
            errors.forEach(function (e) {
                var li = document.createElement("li");
                li.textContent = e;
                ul.appendChild(li);
            });

            // Show Bootstrap modal
            var myModal = new bootstrap.Modal(document.getElementById('validationModal'));
            myModal.show();
        });
        </script>
    }
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/customscripts")
    @RenderSection("scripts", required: false)
</body>
</html>
