@{
    ViewBag.Title = "Classical Music - Raag, Tala, Compositions, Lyrics, Notations, etc.";
}

<main>
    <div class="row">
        <h1 id="title" class="page-header">@Resources.Labels.HomePageTitle</h1>
        <p class="lead">@Resources.Labels.HomePageSubSubTitle</p>
    </div>

    <div class="row m-0 p-0" id="homepage_main_section">
        <section class="col-md-4">
            @Html.Action("RaagaOfTheDay", "Home")
        </section>
        <section class="col-md-4">
            @Html.Action("ArtistOfTheDay", "Home")
        </section>
        <section class="col-md-4">
            @Html.Action("LatestAdditions", "Home")
        </section>
    </div>

    <div class="row text-center mt-4">
        @Html.Action("EminentGurus", "Home")
    </div>
</main>